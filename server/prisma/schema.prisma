// Data model for Story 1 (see docs/story-1-admin-creates-users.md §7 and §8
// for the full reasoning behind every field and the decisions that shaped it).
//
// Conventions:
//   - Models are PascalCase; tables are mapped to snake_case via @@map.
//   - Columns are camelCase in TypeScript; mapped to snake_case via @map.
//   - Enums are SCREAMING_CASE, matching the permission matrix's own vocabulary.
//   - Primary keys are UUIDs, generated by Postgres itself (gen_random_uuid()),
//     not by the application — so any process that inserts a row gets a valid,
//     collision-resistant id without needing this schema's generator logic.

// Prisma 7 made `prisma-client` (not the old `prisma-client-js`) the default
// generator, and it requires an explicit `output` path rather than writing
// into node_modules — generated code lives in src/ and is gitignored, and
// every import in this project goes through src/generated/prisma, never
// through the bare `@prisma/client` package.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// As of Prisma 7, the connection string is no longer read from this file —
// it's supplied to the CLI via prisma.config.ts (for migrate/generate) and to
// PrismaClient via a driver adapter at runtime (see PrismaService).
datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
  CONTRIBUTOR
  VIEWER
}

enum UserStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  DEACTIVATED
}

model User {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Always lower-cased + trimmed by the application before it reaches this
  // column (see docs/tech-stack-decisions.md) — plain `@unique` is enough
  // because the app guarantees the canonical form, without needing the
  // Postgres `citext` extension as an enabling migration.
  email        String @unique

  passwordHash String @map("password_hash")

  // Null until an Admin approves the registration (decision 8.2: the
  // applicant's own suggestion is stored separately in requestedRole and is
  // never authoritative).
  role          Role?
  requestedRole Role?      @map("requested_role")
  status        UserStatus @default(PENDING_APPROVAL)

  // Who approved this account and when — also doubles as the audit trail
  // decision 8.2 relies on ("the Admin's own choice is what's saved").
  approvedById String? @map("approved_by_id") @db.Uuid
  approvedBy   User?   @relation("ApprovedByAdmin", fields: [approvedById], references: [id], onDelete: SetNull)
  approved     User[]  @relation("ApprovedByAdmin")
  approvedAt   DateTime? @map("approved_at")

  // Decision 8.3: a rejected email is reused on re-registration, not
  // discarded — these two fields are what preserve the history that would
  // otherwise be lost.
  rejectionCount Int       @default(0) @map("rejection_count")
  lastRejectedAt DateTime? @map("last_rejected_at")

  // Lets JwtStrategy reject an access token minted before the user's last
  // password change (comparing the JWT's issued-at time against this),
  // even though the token itself hasn't expired yet.
  passwordChangedAt DateTime? @map("password_changed_at")

  createdAt   DateTime  @default(now()) @map("created_at")
  lastLoginAt DateTime? @map("last_login_at")

  refreshTokens RefreshToken[]

  @@map("users")
}

// One row per refresh token ever issued. `familyId` is constant across every
// rotation that descends from a single login; `id`+`secretHash` change every
// time `/auth/refresh` is called. See docs/story-1-admin-creates-users.md §8.4
// for why rotation-with-reuse-detection needs this shape instead of a single
// long-lived token.
model RefreshToken {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  familyId String @map("family_id") @db.Uuid

  // Only the argon2 hash of the random secret is stored — the raw secret
  // exists only inside the httpOnly cookie handed to the browser, the same
  // way passwordHash never stores a plaintext password.
  secretHash String @map("secret_hash")

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}
