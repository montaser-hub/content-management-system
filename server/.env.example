# Copy this file to .env for local development (`cp .env.example .env`) and
# fill in real values. .env is gitignored on purpose — never commit it.

NODE_ENV=development
PORT=3000

# Must match the credentials in docker-compose.yml's `db` service.
DATABASE_URL="postgresql://cms_user:cms_password@localhost:5432/cms_db?schema=public"

# Signs and verifies the access-token JWT. Refresh tokens are opaque random
# values, not JWTs (see opaque-token.util.ts) — there is only one secret here.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Use a different value again in production.
JWT_ACCESS_SECRET="replace-with-a-generated-secret"

# Seconds/days — see docs/story-1-admin-creates-users.md §4.1 for why these values.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of origins allowed to send credentialed (cookie) requests.
# No wildcard — see docs/tech-stack-decisions.md on why an open CORS policy is
# unsafe once cookies are involved.
CORS_ORIGIN="http://localhost:5173"
