# Used by e2e tests (test/jest-e2e.json loads this via dotenv in
# test/setup-e2e.ts) — a separate database from local dev so running the
# test suite never touches, or gets confused by, whatever data is sitting in
# cms_db during manual testing.
NODE_ENV=test
PORT=3001
DATABASE_URL="postgresql://cms_user:cms_password@localhost:5432/cms_test_db?schema=public"
JWT_ACCESS_SECRET="test-access-secret-do-not-use-in-real-environments"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGIN="http://localhost:5173"
